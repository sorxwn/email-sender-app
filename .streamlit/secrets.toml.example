# EXEMPLU - copiaza ca `.streamlit/secrets.toml` (local) sau lipeste in
# Streamlit Cloud: aplicatia ta -> Settings -> Secrets.
# ATENTIE: `secrets.toml` NU se urca pe GitHub (e in .gitignore)!

# Varianta recomandata (tabel TOML) - completezi fiecare camp din JSON-ul
# descarcat de la Google Cloud (Keys -> Create new key -> JSON):
[gspread_service_account]
type = "service_account"
project_id = "numele-proiectului-tau"
private_key_id = "....."
private_key = "-----BEGIN PRIVATE KEY-----\n.....\n-----END PRIVATE KEY-----\n"
client_email = "nume-cont@proiect.iam.gserviceaccount.com"
client_id = "....."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/nume-cont%40proiect.iam.gserviceaccount.com"

# Optional: linkul tabelului (aplicatia il foloseste automat la deschidere):
# sheet_url = "https://docs.google.com/spreadsheets/d/...../edit"

# Varianta alternativa (tot JSON-ul ca string pe o singura cheie):
# gspread_service_account = '''{...lipesti tot JSON-ul aici...}'''
